{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caezium/skills/blob/main/schema/skills-lock.schema.json",
  "title": "Henry skills provenance lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "canonicalRepo",
    "sources",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "canonicalRepo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "url", "branch", "auditedCommit"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "auditedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "repo",
        "url",
        "branch",
        "pinnedCommit",
        "pinBasis",
        "lastCheckedAt"
      ],
      "properties": {
        "kind": {
          "enum": ["git", "managed", "unknown"]
        },
        "label": {"type": "string", "minLength": 1},
        "repo": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "pinnedCommit": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        },
        "pinBasis": {
          "enum": [
            "audited-remote-snapshot",
            "canonical-repo",
            "local-clone-unverified-upstream",
            "managed-without-version",
            "source-known-commit-missing",
            "unknown"
          ]
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "contentPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "basis"],
      "properties": {
        "kind": {"enum": ["git-tree", "sha256"]},
        "value": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "basis": {
          "enum": [
            "canonical-at-pinned-commit",
            "planned-staging-content",
            "integration-target-content",
            "audited-upstream-tree",
            "local-copy-unverified-upstream"
          ]
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "kind",
        "sourceId",
        "sourcePath",
        "sourceTree",
        "content",
        "localOverlays",
        "updatePolicy",
        "lastCheckedAt",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "state": {
          "enum": ["active", "planned-add", "planned-retire"]
        },
        "kind": {
          "enum": [
            "custom",
            "vendored",
            "vendored-overlay",
            "legacy-vendored",
            "source-unknown",
            "managed-mirror"
          ]
        },
        "sourceId": {"type": ["string", "null"]},
        "sourcePath": {"type": ["string", "null"]},
        "sourceTree": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        },
        "content": {"$ref": "#/$defs/contentPin"},
        "localOverlays": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "updatePolicy": {
          "enum": [
            "personal-repo",
            "reviewed-source-update",
            "reviewed-overlay-rebase",
            "managed-upstream",
            "identify-source-before-update",
            "frozen-pending-decision"
          ]
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {"type": "string"},
        "replacedBy": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
